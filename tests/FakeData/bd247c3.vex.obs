*------------------------------------------------------------------------------
$GLOBAL;
     ref $EXPER = bd247c3;
*                                                      +------------+
*                         PI revision number:          |    1.0000  |
*                                                      +------------+
*    mode:       2048-16-2
*------------------------------------------------------------------------------
$EXPER;
*
def bd247c3;
     exper_name = bd247c3;
     exper_description = "bd247";
     PI_name = "A.T. Deller";
     PI_email = adeller@astro.swin.edu.au;
*    address:   Swinburne University
*               PO Box 218
*               Hawthorn VIC 3122 Australia
*                
*    phone:     +61-3-9214-5307 (w)
*    during obs:+61-3-9214-5307 (w)
*    fax:       +61-3-9214-8797
*    notes:     fringe finder, manual pcal, amplitude check: J0745+1011
*
*    year, doy: 2022,  96
*    date     : Wed  6 Apr 2022
*    MJD      : 59675
     exper_nominal_start=2022y096d01h20m11s;
     exper_nominal_stop=2022y096d02h20m12s;
*
     target_correlator = SOCORRO;
*
*    integr_time    :     2.000 s
*    number_channels:    64
*    number_antenna : 10
*    cross_polarize : No
*    weight_func    : UNIFORM
*    distrib_medium : FTP
*    distrib_format : FITS
*    source_pos_cat : FROM .SUM FILE ONLY
*    corr_notes : 
*               7 correlation passes requested: gated+ungated on J0737, and
*               5 calib passes at different inbeam positions.
*
enddef;
*------------------------------------------------------------------------------
$MODE;
*
def 20cm-vlba;
     ref $PROCEDURES = Mode_01;
     ref $FREQ = 1392.00MHz16x32MHz:Sc:Hn:Nl:Fd:La:Pt:Kp:Ov:Br:Mk;
     ref $IF = LO@2400MHzDPolNoTone:Sc:Hn:Nl:Fd:La:Pt:Kp:Ov:Br:Mk;
     ref $BBC = 16BBCs:Sc:Hn:Nl:Fd:La:Pt:Kp:Ov:Br:Mk;
     ref $TRACKS = MARK5B.16Ch2bit1to1:Sc:Hn:Nl:Fd:La:Pt:Kp:Ov:Br:Mk;
*    ref $HEAD_POS = DiskVoid <= obsolete definition
     ref $ROLL = NoRoll:Sc:Hn:Nl:Fd:La:Pt:Kp:Ov:Br:Mk;
*    ref $PASS_ORDER = DiskVoid <= obsolete definition
     ref $PHASE_CAL_DETECT = NoDetect:Sc:Hn:Nl:Fd:La:Pt:Kp:Ov:Br:Mk;
enddef;
*------------------------------------------------------------------------------
$STATION;
*
def Sc;
     ref $SITE = VLBA_SC;
     ref $ANTENNA = VLBA_SC;
     ref $DAS = 2RDBE2+NONE<;
enddef;
*
