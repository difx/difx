# base .v2d file generated by oms2v2d version 0.5 operating on file bb271b.oms

vex = bd247c3.vex.obs

antennas = BR, FD, HN, KP, LA, MK, NL, OV, PT, SC

# original window started 02:18:00 (mjdStart 59675.09583333, mjdStop
# 59675.09653444 = 60.6s) but not all antennas are on source at the very
# start - a short window there yields only 4 active datastreams. Start
# +20s instead.
# The benchmark metric is T(5s of data) - T(1s of data), which cancels
# start-up/shutdown costs; run-bench.sh generates both jobs from this
# file by rewriting mjdStop (1s: 59675.09607640, 5s: 59675.09612270,
# padded high so MJD rounding cannot fall below minLength).
# See BENCHMARKS.md. For nsys profiling ~4s (59675.09611111) is right.
mjdStart = 59675.09606481
mjdStop  = 59675.09612268

# permit the benchmark's 1s leg (vex2difx default minLength is 2s)
minLength = 0.5

SETUP default
{
  # 1s integrations so the 1s benchmark leg contains a whole number of them
  tInt = 1.000
  nChan = 64
  nFFTChan = 128
  doPolar = True
  # 25 ms needs ~6.9 GB device memory; 20 ms (~5.8 GB) fits the RTX 2070's
  # 8 GB and is the benchmark config. nsys/CUPTI tracing needs extra VRAM
  # on top, so use 10 ms (~2.9 GB) when profiling.
  subintNS = 20000000
}

RULE default { setup = default }

# without these vex2difx writes no .threads file and mpifxcorr's config
# parsing derails (threads<-calc, calc<-im); 1 core rank, 10 threads
nCore = 1
nThread = 10

ANTENNA BR
{
  source = fake
  format = VDIF/8032/2
  phaseCalInt = 0
}
ANTENNA FD
{
  source = fake
  format = VDIF/8032/2
  phaseCalInt = 0
}
ANTENNA HN
{
  source = fake
  format = VDIF/8032/2
  phaseCalInt = 0
}
ANTENNA KP
{
  source = fake
  format = VDIF/8032/2
  phaseCalInt = 0
}
ANTENNA LA
{
  source = fake
  format = VDIF/8032/2
  phaseCalInt = 0
}
ANTENNA MK
{
  source = fake
  format = VDIF/8032/2
  phaseCalInt = 0
}
ANTENNA NL
{
  source = fake
  format = VDIF/8032/2
  phaseCalInt = 0
}
ANTENNA OV
{
  source = fake
  format = VDIF/8032/2
  phaseCalInt = 0
}
ANTENNA PT
{
  source = fake
  format = VDIF/8032/2
  phaseCalInt = 0
}
ANTENNA SC
{
  source = fake
  format = VDIF/8032/2
  phaseCalInt = 0
}
