  fanout_def = A : &CH14 : sign : 1 : 16;
  fanout_def = A : &CH1  : sign : 1 : 18;
  fanout_def = A : &CH3  : sign : 1 : 20;
  fanout_def = A : &CH5  : sign : 1 : 22;
  fanout_def = A : &CH7  : sign : 1 : 24;
  fanout_def = A : &CH9  : sign : 1 : 26;
  fanout_def = A : &CH11 : sign : 1 : 28;
