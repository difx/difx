$IVEX_REV;
*-------------------------
rev = 1.0;

*-------------------------
$CORR_INIT;
*-------------------------
 def INIT_A;
  system_tempo = 1.00;
  bocf_period  = 16000000;  * 2 bocfs per second

  *
  ref $PBS_INIT = PBS_0;
  ref $PBS_INIT = PBS_1;
*  ref $PBS_INIT = PBS_2;
 enddef;

*-------------------------
$PBS_INIT;
*-------------------------
 def PBS_0;
  SU_ID                =  0 : SU0;
  ref $DRIVE_INIT      =  DRIVE_A;
  ref $TRM_CONFIG      =  TRM1;
* ref $SU/CORR_CONNECT =  STD0;
  ref $SU/CORR_CONNECT =  TEST0;
* ref $SU/CORR_CONNECT =  TEST1;   *auto-correlation test  rjc 99.7.29
 enddef;

 def PBS_1;
  SU_ID                =  1 : SU1;
  ref $DRIVE_INIT      =  DRIVE_B;
  ref $TRM_CONFIG      =  TRM1;
* ref $SU/CORR_CONNECT =  STD1;
  ref $SU/CORR_CONNECT =  TEST1;
* ref $SU/CORR_CONNECT =  TEST0;   *auto-correlation test  rjc 99.7.26
 enddef;

*-------------------------
$DRIVE_INIT;
*-------------------------
 def DRIVE_A;
  * mkiv drive, s/n 4603004AJ85
  drive_type     = Mark4; * Mark4|VLBA
  capstan_relative_diameter = 1.014;

  vacuum_setting    = 5 : 0x0c80 : 15 : 0x1450;  * @ HAYSTACK, drive 0
  tape_acceleration   = 67.5 ;

 *                         hdstk   trks    DIMin   Eqlzr(Mbps)
  headstack/DIM_connect  =   1   : even  :   0   :   8;
  headstack/DIM_connect  =   1   :  odd  :   1   :   8;
 *                         hdstk    fwd    rev     eqlzr
  monitor_module_track   =   1   :   21  :  21   :   2; * NB! forward value is wrong, but not used

 *                       hdstk    fbias   rbias  ffspeed  fsspeed rfspeed rsspeed pscale  nscale
  headstack_parms    =     1   : -187.7: -185.9:   160.6:    15.0:  153.9:   13.9: 178.6:  179.1;   * 1997-07-16
 enddef;

 def DRIVE_B;
  * mkiv drive, s/n 4903059KD86
  drive_type     = Mark4;
  capstan_relative_diameter = 1.014;

  vacuum_setting    = 5 : 0x0ed8 : 15 : 0x1900; * @ HAYSTACK, drive 1
  tape_acceleration   = 67.5 ;

 *                          hdstk trks DIMin Eqlzr(Mbps)
  headstack/DIM_connect  =   1   : even  :   0   :   8;
  headstack/DIM_connect  =   1   :  odd  :   1   :   8;

 *                           hdstk    fwd    rev     eqlzr
  monitor_module_track   =   1   :   20  :  20   :   2; * NB! forward value is wrong, but not used

 *                       hdstk    fbias   rbias  ffspeed  fsspeed rfspeed rsspeed pscale  nscale
  headstack_parms    =     1   : -136.5: -124.4:   115.7:    14.1:  121.5:   15.2: 173.3:  175.9;   * 1999-04-07
 enddef;

*-------------------------
$TRM_CONFIG;
*-------------------------
 def TRM1;
 *                           M  b/s
  TRM_order_within_channel = 4 : 2 : sign0 :  mag0  :  sign1 :  mag1 : sign2 :  mag2 : sign3 : mag3;
  TRM_order_within_channel = 2 : 2 : sign0 :  mag0  :  sign1 :  mag1;
  TRM_order_within_channel = 1 : 2 : sign0 :  mag0;
  TRM_order_within_channel = 4 : 1 : sign0 :  sign1 :  sign2 :  sign3;
  TRM_order_within_channel = 2 : 1 : sign0 :  sign1;
  TRM_order_within_channel = 1 : 1 : sign0;
 *
  parity_error_limit          =   1.0e-2;  * 1%

 *                                CRC    PErr   nosync  resync
  invalid_frame_control       =   on  :  on  :  off  :  on;
* invalid_frame_control       =   off :  off :  off  :  off;  * rjc 990723 -- CHANGE BACK!!!
 enddef;

*-------------------------
$SU/CORR_CONNECT;

 def TEST0;
 *              SU   Corr   InputBd
 *            ChnGrp Segmt  ChnGrp
  SU_connect =  3 :  0  :    0;
  SU_connect =  1 :  1  :    0;
  SU_connect =  2 :  2  :    0;
  SU_connect =  0 :  3  :    0;
 enddef;

 def TEST1;
 *              SU   Corr   InputBd
 *            ChnGrp Segmt  ChnGrp
  SU_connect =  3 :  0  :    1;
  SU_connect =  1 :  1  :    1;
  SU_connect =  2 :  2  :    1;
  SU_connect =  0 :  3  :    1;
 enddef;
