$OVEX_REV;
rev = 1.5;
*
*-------------------------
$GLOBAL;
*-------------------------
 ref $EXPER = EXP2611;
 ref $EOP   = EOP129;

*-------------------------
$STATION;
*-------------------------
 def B;
  ref $SITE    = EFLSBERG;
  ref $ANTENNA = EFLSBERG;
  ref $DAS     = Mark3A;
  ref $DAS     = 33KBPI;
  ref $DAS     = 8820FT;
  ref $DAS     = EF_ID;
  ref $DAS     = START/STOP;
  ref $PHASE_CAL_DETECT = STANDARD;
  ref $CLOCK   = EF;
  ref $TAPELOG_OBS   = EF;
 enddef;

 def Y;
  ref $SITE    = VLA;
  ref $ANTENNA = VLA;
  ref $DAS     = Mark3A;
  ref $DAS     = 33KBPI;
  ref $DAS     = 8820FT;
  ref $DAS     = VLA_ID;
  ref $DAS     = START/STOP;
  ref $PHASE_CAL_DETECT = STANDARD;
  ref $CLOCK   = VLA;
  ref $TAPELOG_OBS   = VLA;
 enddef;

*-------------------------
$MODE;
*-------------------------
 def C14;
  ref $FREQ    = C14;
  ref $BBC    = C14;
  ref $IF     = C14;
  ref $TRACKS    = Mark3A/56-14-1/14;
  ref $TRACKS    = MARK4_TRK_FORMAT;
  ref $HEAD_POS   = VLBA/1_HDSTK;
  ref $PASS_ORDER   = Mark3A/ModeC;
  ref $ROLL    = ROLL_OFF;
* ref $PROCEDURES   = STANDARD_CAL;
  ref $DAS    = START/STOP;
 enddef;

*-------------------------
$SCHED;
*-------------------------
 scan 062-094600;
  start  = 1993y062d09h46m00s;
  mode   = C14;
  source = 3C345;
 *          stn data   data    strt
 *          key start  stop    pos       pass
  station = B : 0 sec: 55 sec: 3500 ft : 11B : : 1;  * changed to pass B  rjc 99.6.15
  station = Y : 0 sec: 55 sec: 3550 ft : 8A  : : 1;
 endscan;
*
*-------------------------
$ANTENNA;
*-------------------------
 def EFLSBERG;
  antenna_diam = 100 m;
  axis_type  = az : el;
  axis_offset  = az :  0 m;
 *                      type  slew         settle
  antenna_motion = az : 90 deg/min : 2 sec;
  antenna_motion = el : 30 deg/min : 1 sec;
 *                       sec id   axis  LoLim     HiLim    axis  LoLim   HiLim
  pointing_sector = &ccw : az : -90 deg :  90 deg : el : 0 deg : 88 deg;
  pointing_sector = &n   : az :  90 deg : 270 deg : el : 0 deg : 88 deg;
  pointing_sector = &cw  : az : 270 deg : 450 deg : el : 0 deg : 88 deg;
 enddef;

 def VLA;
  antenna_diam = 25 m;
  axis_type  = az : el;
  axis_offset  = az : 0 m;
 *                      type  slew         settle
  antenna_motion = az : 90 deg/min : 2 sec;
  antenna_motion = el : 30 deg/min : 1 sec;
 *                       sec id   axis  LoLim     HiLim    axis  LoLim   HiLim
  pointing_sector = &ccw : az : -90 deg :  90 deg : el :  0 deg :  88 deg;
  pointing_sector = &n   : az :  90 deg : 270 deg : el :  0 deg :  88 deg;
  pointing_sector = &cw  : az : 270 deg : 450 deg : el :  0 deg :  88 deg;
  pointing_sector = &ccwp: az : -90 deg :  90 deg : el : 92 deg : 120 deg;
  pointing_sector = &np  : az :  90 deg : 270 deg : el : 92 deg : 120 deg;
  pointing_sector = &cwp : az : 270 deg : 450 deg : el : 92 deg : 120 deg;
 enddef;

*-------------------------
$BBC;
*-------------------------
 def C14;
 *                   BBC id    phys#     IF id
  BBC_assign = &BBCa :  1 : &IF_CL;
  BBC_assign = &BBCb :  2 : &IF_CR;
  BBC_assign = &BBCc :  3 : &IF_CL;
  BBC_assign = &BBCd :  4 : &IF_CR;
  BBC_assign = &BBCe :  5 : &IF_CL;
  BBC_assign = &BBCf :  6 : &IF_CR;
  BBC_assign = &BBCg :  7 : &IF_CL;
  BBC_assign = &BBCh :  8 : &IF_CR;
  BBC_assign = &BBCi :  9 : &IF_CL;
  BBC_assign = &BBCj : 10 : &IF_CR;
  BBC_assign = &BBCk : 11 : &IF_CL;
  BBC_assign = &BBCl : 12 : &IF_CR;
  BBC_assign = &BBCm : 13 : &IF_CL;
  BBC_assign = &BBCn : 14 : &IF_CR;
 enddef;

*-------------------------
$CLOCK;
*-------------------------
 def EF;
 *                   valid from          clock early     clock early epoch       rate
  clock_early = 1993y061d00h00m : -2.08 usec : 1993y061d00h00m0s : 0;
 enddef;

 def VLA;
 *                   valid from          clock early     clock early epoch       rate
  clock_early = 1993y061d00h00m : 230.6 usec : 1993y061d00h00m0s : 0;
 enddef;

*-------------------------
$DAS;
*-------------------------
 def Mark3A;
  record_transport_type = Mark3A;
  electronics_rack_type = Mark3A;
  number_drives   = 1;
 *                 hdstk               drv#offset
  headstack = 1 : write : 0;
  headstack = 1 : read : 0;
 enddef;

 def 33KBPI;
  record_density = 33333 bpi; * 'raw' bit density per track
 enddef;

 def 8820FT;
  tape_length  = 8820 ft;
 enddef;

 def EF_ID;
  recording_system_ID = 6;
 enddef;

 def VLA_ID;
  recording_system_ID = 65;
 enddef;

 def START/STOP;
  tape_motion   = start_stop; * no early start
 enddef;

*-------------------------
$EOP;
*-------------------------
 def EOP129;
  TAI-UTC = 26 sec;
  A1-TAI = 0.03439 sec;
  eop_ref_epoch = 1993y061d;
  num_eop_points = 3;
  eop_interval = 24 hr;
  ut1-utc   = -0.09527 sec : -0.09527 sec : -0.09527 sec;
  x_wobble  =  0.1727 asec :  0.1727 asec : 0.1727 asec;
  y_wobble  =  0.2107 asec :  0.2107 asec : 0.2107 asec;
 enddef;

*-------------------------
$EXPER;
*-------------------------
 def EXP2611;
  exper_num = 2611;
  exper_name = BR7A;
  exper_description = "Roberts et al";
  exper_nominal_start = 1993y061d23h10m;
  exper_nominal_stop = 1993y062d13h30m;
 enddef;

*-------------------------
$FREQ;
*-------------------------
 def C14;
 *           ch   band    sky freq    net  chan   chan     BBC    phase-cal
 *          name   id    at 0Hz BBC   SB    BW     id      id       id
  chan_def = CL1 : &C : 4977.99 MHz : U : 2 MHz : &CH1  : &BBCa : &USB_CAL;
  chan_def = CR1 : &C : 4977.99 MHz : U : 2 MHz : &CH2  : &BBCb : &USB_CAL;
  chan_def = CR2 : &C : 4979.99 MHz : U : 2 MHz : &CH4  : &BBCd : &USB_CAL;
  chan_def = CL3 : &C : 4981.99 MHz : U : 2 MHz : &CH5  : &BBCe : &USB_CAL;
  chan_def = CR3 : &C : 4981.99 MHz : U : 2 MHz : &CH6  : &BBCf : &USB_CAL;
  chan_def = CL4 : &C : 4983.99 MHz : U : 2 MHz : &CH7  : &BBCg : &USB_CAL;
  chan_def = CR4 : &C : 4983.99 MHz : U : 2 MHz : &CH8  : &BBCh : &USB_CAL;
  chan_def = CL5 : &C : 4985.99 MHz : U : 2 MHz : &CH9  : &BBCi : &USB_CAL;
*
* moved following channel so it would appear as output channel 8  rjc  99.6.16
  chan_def = CL2 : &C : 4979.99 MHz : U : 2 MHz : &CH3  : &BBCc : &USB_CAL;
  chan_def = CR5 : &C : 4985.99 MHz : U : 2 MHz : &CH10 : &BBCj : &USB_CAL;
  chan_def = CL6 : &C : 4987.99 MHz : U : 2 MHz : &CH11 : &BBCk : &USB_CAL;
  chan_def = CR6 : &C : 4987.99 MHz : U : 2 MHz : &CH12 : &BBCl : &USB_CAL;
  chan_def = CL7 : &C : 4989.99 MHz : U : 2 MHz : &CH13 : &BBCm : &USB_CAL;
  chan_def = CR7 : &C : 4989.99 MHz : U : 2 MHz : &CH14 : &BBCn : &USB_CAL;
  sample_rate = 4 Ms/sec;
 enddef;

*-------------------------
$HEAD_POS;
*-------------------------
 def VLBA/1_HDSTK;
 *                       pos     hdstk-1
 *                      ref#     position
  headstack_pos =  1 : -330 um;
  headstack_pos =  2 : -275 um;
  headstack_pos =  3 : -220 um;
  headstack_pos =  4 : -165 um;
  headstack_pos =  5 : -110 um;
  headstack_pos =  6 :  -55 um;
  headstack_pos =  7 :    0 um;
* headstack_pos =  8 :   55 um;
* The following pass is a quick & dirty change to account for the oddball VLBA
* pass table.  A correct fix would have two different $HEAD_POS sections, pointed
* to by different MODE def's.              rjc  99.3.30
*
  headstack_pos =  8 :   79 um;
  headstack_pos =  9 :  110 um;
  headstack_pos = 10 :  165 um;
  headstack_pos = 11 :  220 um;
  headstack_pos = 12 :  275 um;
 enddef;

*-------------------------
$IF;
*-------------------------
 def C14;
 *                 phys      total    net  phase-cal p-cal base
 *         IF id   name pol  LO        SB   freq spacing freq
  if_def = &IF_CR : AN : R : 4500 MHz : U : 1 MHz : 0 Hz;
  if_def = &IF_CL : BN : L : 4500 MHz : U : 1 MHz : 0 Hz;
 enddef;

*-------------------------
$PASS_ORDER;
*-------------------------
 def Mark3A/ModeC;
  pass_order = 1B : 1A : 2B : 2A : 3B : 3A : 4B : 4A : 5B : 5A : 6B : 6A :
     7B : 7A : 8B : 8A : 9B : 9A :10B :10A :11A :11B :12B :12A ;
* above line - swapped 11A with 11B to keep B happy       rjc 99.6.15
 enddef;

*-------------------------
$PHASE_CAL_DETECT;
*-------------------------
 def STANDARD;
 *                   pcal id  tone# tone#
  phase_cal_detect = &USB_CAL : 1 : -1;
 enddef;

*-------------------------
$ROLL;
*-------------------------
 def ROLL_OFF;
  roll = off;
 enddef;

