*------------------------------------------------------------------------------
$MODE;
*
def 1mmlcp;
*    ref $IF = IF_NOMINAL:Nn:Pv:Gl:Ax:Sz:Kt:Mg:Sw:Mm:Ax;
*    ref $FREQ = FREQ_COMMON:Gl:Sz:Kt:Mg:Sw:Mm:Ax;
*    ref $FREQ = FREQ_COMMON:Sz:Kt:Mm:Ax;
*    ref $FREQ = FREQ_SW:Gl:Mg:Sw;
    ref $FREQ = ant00:Aa;
    ref $FREQ = ant01:Gl;
    ref $FREQ = ant02:Mg;
    ref $FREQ = ant03:Mm;
    ref $FREQ = ant04:Sw;
    ref $BBC = bbcs;
    ref $IF = ifs;
    ref $TRACKS = trax_2bit:Aa:Gl:Mg:Mm:Sw;
enddef;
*------------------------------------------------------------------------------
$STATION;
*
def Aa;
     ref $SITE = ALMA;
     ref $ANTENNA = ALMA;
    ref $CLOCK = Aa;
enddef;
*
def Ax;
