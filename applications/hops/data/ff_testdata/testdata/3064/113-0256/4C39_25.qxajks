 def DRIVE_E;
  * MkIV drive, s/n 4302917RA85
  drive_type     = Mark4;
  *             address    ID
  mcb_address = 0x2400 : 0x34;
  capstan_relative_diameter = 1.014;

  vacuum_setting    = 5 : 0x11c6 : 15 : 0x11c6; * @ HAYSTACK, drive 4
  tape_acceleration = 67.5 ;

 *                         hdstk   trks    DIMin   Eqlzr(Mbps)
  headstack/DIM_connect  =   1   : even  :   0   :   8;
  headstack/DIM_connect  =   1   :  odd  :   1   :   8;
  headstack/DIM_connect  =   1   : even  :   2   :   4;
  headstack/DIM_connect  =   1   :  odd  :   3   :   4;

 *                         hdstk    fwd    rev    eqlzrs (Mbps)
  monitor_module_track   =   1   :   21  :  20   :   2 : 4 : 8;  * rjc 2001.4.25

 *                         hdstk    fbias   rbias  ffspeed  fsspeed rfspeed rsspeed pscale  nscale
  headstack_parms        =   1   :  -97.6:  -66.2:   190.2:    19.6:  181.9:   20.3: 174.4:  173.7;   * 2002.12.31
 enddef;

 def DRIVE_F_MARK5;
  * MkV prototype, name mark5-03
  drive_type     = Mark5A : mark5-03 ;
 *                         hdstk   trks    DIMin   Eqlzr(Mbps)
  headstack/DIM_connect  =   1   : even  :   2   :   0;
  headstack/DIM_connect  =   1   :  odd  :   3   :   0;
* enable headstack 2 for Mark 5
  headstack/DIM_connect  =   2   : even  :   0   :   0;
  headstack/DIM_connect  =   2   :  odd  :   1   :   0;
 enddef;

 def DRIVE_G_MARK5;
  * MkV prototype, name mark5-21
  drive_type     = Mark5A : mark5-21 ;
 *                         hdstk   trks    DIMin   Eqlzr(Mbps)
  headstack/DIM_connect  =   1   : even  :   2   :   0;
  headstack/DIM_connect  =   1   :  odd  :   3   :   0;
* enable headstack 2 for Mark 5
  headstack/DIM_connect  =   2   : even  :   0   :   0;
  headstack/DIM_connect  =   2   :  odd  :   1   :   0;

 enddef;

* def DRIVE_H_MARK5;
*  * MkV prototype, name dhcp242
**  drive_type     = Mark5A : dhcp242 ;
*  drive_type     = Mark5A : mark5-21 ;
* *                         hdstk   trks    DIMin   Eqlzr(Mbps)
*  headstack/DIM_connect  =   1   : even  :   0   :   0;
*  headstack/DIM_connect  =   1   :  odd  :   1   :   0;
** enable headstack 2 for Mark 5
*  headstack/DIM_connect  =   2   : even  :   2   :   0;
*  headstack/DIM_connect  =   2   :  odd  :   3   :   0;
*
* enddef;

*-------------------------
$TRM_CONFIG;
*-------------------------
 def TRM1;
 *                           M  b/s
  TRM_order_within_channel = 4 : 2 : sign0 :  mag0  :  sign1 :  mag1 : sign2 :  mag2 : sign3 : mag3;
  TRM_order_within_channel = 2 : 2 : sign0 :  mag0  :  sign1 :  mag1;
  TRM_order_within_channel = 1 : 2 : sign0 :  mag0;
  TRM_order_within_channel = 4 : 1 : sign0 :  sign1 :  sign2 :  sign3;
  TRM_order_within_channel = 2 : 1 : sign0 :  sign1;
  TRM_order_within_channel = 1 : 1 : sign0;
 *
  parity_error_limit          =   0.10;  * 10% (for frame editting purposes only)

 *                                CRC    PErr   nosync  resync
  invalid_frame_control       =   off :  on  :  off  :  on;
 enddef;

 def TRM5;
 *                           M  b/s
  TRM_order_within_channel = 4 : 2 : sign0 :  mag0  :  sign1 :  mag1 : sign2 :  mag2 : sign3 : mag3;
  TRM_order_within_channel = 2 : 2 : sign0 :  mag0  :  sign1 :  mag1;
  TRM_order_within_channel = 1 : 2 : sign0 :  mag0;
  TRM_order_within_channel = 4 : 1 : sign0 :  sign1 :  sign2 :  sign3;
  TRM_order_within_channel = 2 : 1 : sign0 :  sign1;
  TRM_order_within_channel = 1 : 1 : sign0;
 *
  parity_error_limit          =   0.10;  * 10% (for frame editting purposes only)

 *                                CRC    PErr   nosync  resync
  invalid_frame_control       =   off :  off :  off  :  on;
 enddef;

