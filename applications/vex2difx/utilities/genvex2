nScan = 0
chanPerThread = 1

parser = argparse.ArgumentParser(program, 'program to generate sample vex2 and v2d files for use in testing', '')
parser.add_argument('project', help='project code')
parser.add_argument('-a', '--antennas', type=int, help='number of antennas [%d]' % nAntenna, default=nAntenna)
parser.add_argument('-s', '--sources', type=int, help='number of sources [%d]' % nSource, default=nSource)
parser.add_argument('-c', '--chansperpol', type=int, help='number of channels per polarization [%d]' % channelsPerPol, default=channelsPerPol)
parser.add_argument('-t', '--chansperthread', type=int, help='number of channels thread [%d]' % chanPerThread, default=chanPerThread)
parser.add_argument('-n', '--scans', type=int, help='number of scans [%d per source]' % scansPerSource, default=scansPerSource)
parser.add_argument('-f', '--freq', help='base frequency (MHz); comma separate values for multi-band [%s]' % defaultBaseFreqs, default=defaultBaseFreqs)
parser.add_argument('-p', '--polarizations', type=str, help='specify polarizations [%s]' % pols, default=pols)
parser.add_argument('-b', '--chanbw', type=int, help='channel bandwidth (MHz) [%d]' % chanbw, default=chanbw)
parser.add_argument('-d', '--dur', type=int, help='scan duration (sec) [%d]' % scanDur, default=scanDur)
parser.add_argument('-g', '--gap', type=int, help='scan gap (sec) [%d]' % scanGap, default=scanGap)
parser.add_argument('-v', '--payload', type=int, help='VDIF payload size (bytes) [%d]' % vdifPayload, default=vdifPayload)
parser.add_argument('-l', '--iflowersideband', action='store_true', help='Set IF to be LSB (default is USB)')
parser.add_argument('-x', '--complex', action='store_true', help='specify complex-valued data (default is real)')
parser.add_argument('-1', '--onebit', action='store_true', help='specify 1-bit sampling (default is 2 bits)')
parser.add_argument('-4', '--fourbit', action='store_true', help='specify 4-bit sampling (default is 2 bits)')
parser.add_argument('-8', '--eightbit', action='store_true', help='specify 8-bit sampling (default is 2 bits)')
parser.add_argument('-S', '--singleThread', action='store_true', help='put all channels in one thread')
args = parser.parse_args()

project = args.project
nAntenna = args.antennas
nSource = args.sources
channelsPerPol = args.chansperpol
chanPerThread = args.chansperthread
nScan = args.scans
for v in args.freq.split(','):
	baseFreqs.append(float(v))
chanbw = args.chanbw
pols = args.polarizations.upper()
scanDur = args.dur
scanGap = args.gap
vdifPayload = args.payload
if vdifPayload % 8 != 0:
	print('Error: VDIF payload must be a multiple of 8 bytes')
	exit(0)
if args.iflowersideband:
	ifSideband = 'L'
isComplex = args.complex
if args.onebit:
	nBit = 1
if args.fourbit:
	nBit = 4
if args.eightbit:
	nBit = 8

paths = {}

# Derived parameters
if nScan == 0:
	nScan = nSource*scansPerSource
endMJD = startMJD + (nScan*(scanDur + scanGap) - scanGap)/86400.0
nChan = channelsPerPol * len(pols)
if args.singleThread:
	chanPerThread = nChan
fftSpecRes = specRes * 0.5
vexFile = project.lower()+'.vex'
v2dFile = project.lower()+'.v2d'

if nChan % chanPerThread != 0:
	print('Error: must have integer number of channels per thread: %d %% %d = %d' % (nChan, chanPerThread, nChan % chanPerThread))
	exit(0)

# Write .vex file
out = open(vexFile, 'w')
printIntro(out, project, startMJD, endMJD)
printBar(out)
printMODE(out, nAntenna)
printBar(out)
printSTATIONs(out, nAntenna)
printBar(out)
printSITEs(out, nAntenna)
printBar(out)
printANTENNAs(out, nAntenna)
printBar(out)
printSOURCEs(out, nSource)
printBar(out)
printFREQ(out, baseFreqs, chanbw, pols, channelsPerPol)
printBar(out)
printIF(out, baseFreqs, pols, ifSideband, pcalInt)
printBar(out)
printBBC(out, pols, channelsPerPol)
printBar(out)
printDATASTREAMS(out, chanbw, nChan, nBit, vdifPayload, isComplex, chanPerThread)
printBar(out)
scans = printSCHED(out, startMJD, nScan, nAntenna, nSource, scanDur, scanGap)
printBar(out)
printCLOCK(out, nAntenna, startMJD)
printBar(out)
printEOP(out, startMJD)
out.close()

# Write .v2d file if requested
out = open(v2dFile, 'w')
out.write('vex = %s\n\n' % vexFile)
if singleScan:
	out.write('singleScan = true\n\n')
out.write('antennas = %s\n\n' % antennaIDList(nAntenna, ', '))
filelistFiles = {}
for a in range(nAntenna):
	ant = antennaID(a)
	ds = ant + '_0'
	filelist = '%s.%s.filelist' % (project.lower(), ant.lower())
	out.write('DATASTREAM %s { filelist=%s }\n' % (ds, filelist))
	out.write('ANTENNA %s { toneSelection=smart datastreams=%s }\n\n' % (ant, ds))
	filelistFiles[ant] = filelist
out.write('SETUP default\n')
out.write('{\n')
out.write('\ttInt = %4.2f\n' % tInt)
out.write('\tspecRes = %6.4f\n' % specRes)
out.write('\tfftSpecRes = %6.4f\n' % fftSpecRes)
out.write('\tdoPolar = True\n')
out.write('\tnumBufferedFFTs = 10\n')
out.write('}\n')
out.close()

genFilelistFiles(project, filelistFiles, scans, paths)
