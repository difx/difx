#ifdef IPP_9_API
// since IPP 9.0 ippsFIRGenLowpass_64f needs a work buffer
inline vecStatus vectorGenerateFIRLowpass_f64(f64 freq, f64 *taps, int length, IppWinType window, IppBool normalise) {
  int bufsize;
  vecStatus status = ippsFIRGenGetBufferSize(length, &bufsize);
  if (status != ippStsNoErr) return status;
  u8 *buf = ippsMalloc_8u(bufsize);
  if (!buf) return ippStsMemAllocErr;
  status = ippsFIRGenLowpass_64f(freq, taps, length, window, normalise, buf);
  ippsFree(buf);
  return status;
}
#else
#define vectorGenerateFIRLowpass_f64(freq, taps, length, window, normalise) ippsFIRGenLowpass_64f(freq, taps, length, window, normalise)
#endif

